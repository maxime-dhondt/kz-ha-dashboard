{
  "name": "glass-home-dashboard",
  "version": "0.1.0",
  "description": "Apple-style glass dashboard for Home Assistant: configurable Lovelace custom cards.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --open /dev/",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run test && npm run format:check && npm run build"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@types/node": "^26.6.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
